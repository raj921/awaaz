# Local secrets and environments
.env
.env.*
!.env.example
.venv/

# Downloaded third-party datasets and derived artifacts
/data/raw/
/data/processed/
/data/audio/
/data/checkpoints/

# Model artifacts
*.safetensors
*.pt
*.pth
*.bin
*.wav
*.mp3

# Python and OS files
__pycache__/
*.py[cod]
.DS_Store

# Frontend (the UI was renamed attunebench-ui -> awaaz-ui; the old ignore
# patterns still pointed at the old directory, so node_modules/.next under
# the current path were untracked-but-not-ignored and showed up in every
# `git status`.)
frontend/*/node_modules/
frontend/*/.next/
frontend/*/out/
frontend/*/.turbo/
next-env.d.ts
*.tsbuildinfo

# Local runtime artifacts (never commit)
graphify-out/
research/memory/.memory_snap.pkl
research/memory/memory.db
research/memory/memory.db-wal
research/memory/memory.db-shm
research/training/endpoint.url
cost.json
